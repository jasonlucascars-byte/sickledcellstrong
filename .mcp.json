{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless",
        "--no-sandbox"
      ]
    },
    "omniroute": {
      "type": "http",
      "url": "http://localhost:20128/api/mcp/stream"
    }
  }
}
