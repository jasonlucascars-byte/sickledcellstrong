# SickleStrong beta signup — environment variables
# ------------------------------------------------------------------
# Copy to `.env` for local testing (`netlify dev`) and set the SAME
# variables in Netlify → Site settings → Environment variables for
# production. NEVER commit real values. NEVER expose the service-role
# key to the browser — it is used only inside the Netlify Functions.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (Project Settings → API → service_role).
# This bypasses Row Level Security, so it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional origin allowlist for the signup function. Comma-separated list of
# exact origins allowed to POST the form, e.g.
#   https://sicklestrong.org,https://www.sicklestrong.org
# Leave empty to skip the check (e.g. for local `netlify dev`). Set it in
# production to your site's origin(s).
ALLOWED_ORIGIN=
